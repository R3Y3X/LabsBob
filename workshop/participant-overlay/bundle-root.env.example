# Configuración del pipeline Track D. El hub genera participant-config.env
# con tu TechZone y número; copiá ese archivo a .env (no uses este example
# como fuente de IDs). El Track F no requiere credenciales locales de Kafka
# para el MCP: el toolkit remoto ya está en la VM.
#
#   cp participant-config.env .env

# ---- Per-student settings --------------------------------------------------
SSH_HOST=root@<IP_PUBLICA_VM_TZ1>
SSH_KEY=trackD/inventory-pipeline/cflt-vsi-key.pem

# ---- Cluster endpoints ------------------------------------------------------
BOOTSTRAP_SERVERS=kafka.confluent.svc.cluster.local:9092
KSQLDB_ENDPOINT=http://ksqldb.confluent.svc.cluster.local:8088
KSQLDB_ENDPOINT_EXTERNAL=https://<IP_PUBLICA_VM_TZ1>/ksqldb

KSQLDB_USERNAME=admin
KSQLDB_PASSWORD=
KSQLDB_API_KEY=admin
KSQLDB_API_SECRET=

KAFKA_SASL_USERNAME=kafka-admin
KAFKA_SASL_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# ---- Track D: Kafka topics & ksqlDB objects (namespaced) -------------------
WORKSHOP_TABLE=1
PARTICIPANT_NUMBER=1
WORKSHOP_ID=tz1_p001
TOPIC_NAME=inventory.transactions.tz1_p001
TOPIC_PARTITIONS=1
TOPIC_REPLICATION_FACTOR=3
TOPIC_RETENTION_MS=-1
DERIVED_TOPIC_NAME=inventory.availability.tz1_p001
KSQL_STREAM_NAME=INVENTORY_TRANSACTIONS_TZ1_P001
KSQL_TABLE_NAME=INVENTORY_AVAILABILITY_TZ1_P001

ORCHESTRATE_URL=""
ORCHESTRATE_API_KEY=
RETAIL_MCP_URL=http://<IP_PUBLICA_VM_TZ1>/retail-mcp/mcp
RETAIL_MCP_TOOLKIT_NAME=retail_availability_mcp
