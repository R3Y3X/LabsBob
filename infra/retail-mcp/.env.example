# Local template for /etc/retail-mcp/retail-mcp.env on one TechZone VM.
# Never commit the real file: it contains Kafka and Schema Registry passwords.
WORKSHOP_TABLE=1
BOOTSTRAP_SERVERS_EXTERNAL=<IP_PUBLICA_VM>:9094,<IP_PUBLICA_VM>:9095,<IP_PUBLICA_VM>:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=kafka-admin
KAFKA_SASL_PASSWORD=REPLACE_ME
SCHEMA_REGISTRY_URL=https://<IP_PUBLICA_VM>/sr
SCHEMA_REGISTRY_USERNAME=admin
SCHEMA_REGISTRY_PASSWORD=REPLACE_ME
TLS_VERIFY=false
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
WORKSHOP_READ_TIMEOUT_SECONDS=25
